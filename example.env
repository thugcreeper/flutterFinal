# Google OAuth 登入客戶端 ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Google Maps Platform API 金鑰 (用於 Directions API、Elevation API 等)
MAPS_PLATFORM_API_KEY=YOUR_MAPS_PLATFORM_API_KEY

# 後端 API 基礎連接網址
API_BASE_URL=YOUR_BACKEND_API_URL

# TDX (交通部運輸資料流通服務) 金鑰 - 用於取得全台觀光景點與餐廳資訊
TDX_CLIENT_ID=YOUR_TDX_CLIENT_ID
TDX_CLIENT_SECRET=YOUR_TDX_CLIENT_SECRET

# OpenRouter AI 模型的 API 金鑰 - 用於 AI 聊天助理與單車路線推薦
AI_API_KEY=YOUR_AI_API_KEY

#用來上傳頭像到Cloudinary的API金鑰
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_UPLOAD_PRESET=YOUR_CLOUDINARY_UPLOAD_PRESET